{
  "name": "@overlord/contract",
  "version": "0.1.0",
  "description": "Shared REST API contract for Overlord server and clients: DTO types, and the Zod schemas and operation table generated from contract/api/openapi.yaml.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/generated/api.d.ts",
      "default": "./dist/generated/api.js"
    },
    "./mcp-tools": {
      "types": "./dist/mcp-tools.d.ts",
      "default": "./dist/mcp-tools.js"
    },
    "./ext/everhour": {
      "types": "./dist/ext/everhour.d.ts",
      "default": "./dist/ext/everhour.js"
    },
    "./ext/github": {
      "types": "./dist/ext/github.d.ts",
      "default": "./dist/ext/github.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "../../node_modules/.bin/tsc --project tsconfig.build.json",
    "typecheck": "../../node_modules/.bin/tsc --project tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
