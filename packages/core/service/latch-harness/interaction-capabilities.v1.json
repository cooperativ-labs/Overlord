{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction-capabilities.v1.json",
  "title": "InteractionCapabilities",
  "description": "Per-session operations a Latch client may safely offer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sendMessage", "sendKeys", "resolve", "canSend"],
  "properties": {
    "sendMessage": {
      "type": "boolean",
      "description": "Free-text message injection is available."
    },
    "sendKeys": {
      "type": "boolean",
      "description": "Direct keypress injection is available."
    },
    "resolve": {
      "type": "boolean",
      "description": "A specific pending requestId can be answered."
    },
    "canSend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "description": "Why input is unsafe or unavailable when ok is false."
        }
      }
    }
  }
}
