  "fetch": [
    {
      "name": "https with query stripped",
      "tool": "fetch",
      "input": {
        "url": "https://api.example.com/v1/items?token=super-secret&page=2"
      },
      "projectRoot": null,
      "expect": {
        "action": "Fetch a URL",
        "subject": "api.example.com",
        "detail": "https://api.example.com/v1/items (query stripped)",
        "riskMarkers": [
          "network-egress"
        ]
      }
    },
    {
      "name": "plain http",
      "tool": "fetch",
      "input": {
        "url": "http://internal.example.com/data"
      },
      "projectRoot": null,
      "expect": {
        "action": "Fetch a URL",
        "subject": "internal.example.com",
        "detail": "http://internal.example.com/data",
        "riskMarkers": [
          "network-egress",
          "secret-adjacent"
        ]
      }
    },
    {
      "name": "loopback http is not flagged",
      "tool": "fetch",
      "input": {
        "url": "http://localhost:3000/health"
      },
      "projectRoot": null,
      "expect": {
        "action": "Fetch a URL",
        "subject": "localhost:3000",
        "detail": "http://localhost:3000/health",
        "riskMarkers": [
          "network-egress"
        ]
      }
    },
    {
      "name": "unparseable",
      "tool": "fetch",
      "input": {
        "url": "not a url ?token=leak"
      },
      "projectRoot": null,
      "expect": {
        "action": "Fetch a URL",
        "subject": null,
        "detail": "[unparseable url]",
        "riskMarkers": [
          "network-egress"
        ]
      }
    }
  ],
