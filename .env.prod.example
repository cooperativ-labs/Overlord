# Production / packaged app defaults. Copy to `.env.prod`.
#
# The desktop packager copies only the runtime app keys below into the bundled
# `.env.prod`; build-time secrets such as `APPLE_*` are consumed during packaging
# but are not shipped in the desktop app.
# Runtime values in `.env.prod` are used as defaults when a packaged app creates
# the user's `overlord.toml`.

GEMINI_API_KEY=

# Resend API key for sending Better Auth verification emails (sender domain:
# notifications.cooperativ.io). Leave unset to keep email verification
# disabled.
RESEND_API_KEY=

# APNs credentials for the backend that delivers Live Activity updates and
# standard push notifications (both surfaces share one signing key; per-device
# registrations pick sandbox vs production independently of OVERLORD_APNS_ENV).
# Supply the `.p8` key as one line with literal `\n` where necessary.
OVERLORD_APNS_TEAM_ID=
OVERLORD_APNS_KEY_ID=
OVERLORD_APNS_PRIVATE_KEY=
OVERLORD_IOS_BUNDLE_ID=
# Set to `sandbox` for development/TestFlight; omit for production APNs.
OVERLORD_APNS_ENV=

APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
APPLE_ID=

OVERLORD_WEB_HOST=127.0.0.1
OVERLORD_WEB_PORT=4310      # Express REST/SSE API port (backend/index.ts).
OVERLORD_BACKEND_URL=http://127.0.0.1:4310

OVERLORD_SQL_STUDIO_HOST=127.0.0.1
OVERLORD_SQL_STUDIO_PORT=4311
OVERLORD_SQL_STUDIO_BINARY=sql-studio

GITHUB_CLIENT_ID=Ov23li4AmMlCjuGgIESL
GITHUB_CLIENT_SECRET=c267ba59c285e1f09869922fdaf43ea280589460


# ---- Overlord Cloud (hosted backend) ------------------------------------
# Set these only for the hosted control plane (Railway + Neon). Local/desktop
# editions leave DATABASE_URL unset and run on SQLite. See the operator runbook
# at private-docs/deployment-overlord-cloud.md (git-ignored).
#
# Hosted Postgres system of record. A postgres:// value selects the Postgres
# adapter for both the data layer and Better Auth (resolveAdapter). Use the
# Neon DIRECT (non-pooled) connection string for migrations; the always-on
# backend can use the direct string too (a bounded pg Pool is the warm pool).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Stable Better Auth signing secret so sessions survive restarts/redeploys.
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Public HTTPS origin of the hosted backend (cookie/redirect base). Also used for
# CORS when browsers call the API from the backend's own domain.
# BETTER_AUTH_URL=https://overlord-backend.up.railway.app
#
# Optional alias for the same public backend origin. Included in CORS and Better
# Auth trusted origins alongside BETTER_AUTH_URL and OVERLORD_BACKEND_URL.
# BACKEND_URL=https://overlord-backend.up.railway.app
#
# Public HTTPS origin of the hosted webapp. Set this on the BACKEND deployment as
# well as the Vercel build: it is the origin MCP OAuth discovery advertises and
# the only `resource` the backend accepts, while Vercel proxies /mcp plus /oauth
# token traffic back to the backend. Unset on the backend, the server can only
# describe its own hostname, so a client that connected to the webapp domain is
# rejected with "OAuth resource must match this Overlord MCP server".
# OVERLORD_WEBAPP_PUBLIC_URL=https://overlord-webapp.vercel.app
#
# In the container the server binds OVERLORD_WEB_HOST=0.0.0.0 and
# OVERLORD_WEB_PORT=$PORT (Railway-injected); SQL Studio is disabled.
#
# Comma-separated browser origins allowed for CORS and Better Auth when the SPA
# is hosted on Vercel (production + preview URLs).
# OVERLORD_WEB_ORIGINS=https://overlord-webapp.vercel.app,https://overlord-webapp-*.vercel.app
#
# GitHub OAuth App for "Continue with GitHub" login. When both are set the auth
# UI shows the GitHub button; unset leaves email/password as the only path.
# Create the app at https://github.com/settings/developers (see the mission
# note) and register the callback URL <BETTER_AUTH_URL>/api/auth/callback/github.
# Repository authorization uses the permitted /repository subpath.
# The app must expose the user's email (grant "Email addresses: read-only" on a
# GitHub App, or request the user:email scope on an OAuth App — already default).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Repository authorization reuses the login OAuth App credentials above, but
# stores its broader-scope token separately. The encryption key must decode
# from base64/base64url to exactly 32 bytes.
GITHUB_USER_TOKEN_ENCRYPTION_KEY=
# Optional dedicated key for Everhour personal API keys. When unset, Everhour
# reuses GITHUB_USER_TOKEN_ENCRYPTION_KEY. Must decode to exactly 32 bytes.
EVERHOUR_API_KEY_ENCRYPTION_KEY=
# Account connections (contracts v152, v156; Knowledgebase is Cloud only). No
# Knowledgebase setup is needed: users open Settings > Connected accounts and click
# Connect. All of the following are optional overrides.
# - KNOWLEDGEBASE_MCP_URL: unset means the standard server
#   (https://knowledge.chaselubitz.com/mcp). Set an HTTPS URL to use another server,
#   or `off` to turn Knowledgebase off. The backend reaches only this origin plus the
#   comma-separated KNOWLEDGEBASE_EGRESS_ORIGINS (an authorization server elsewhere).
#   The OAuth client id is this backend's public /oauth/clients/knowledgebase.json.
# - ACCOUNT_CONNECTIONS_ENCRYPTION_KEY: unset means credentials are sealed with a key
#   derived from BETTER_AUTH_SECRET (so keep that secret stable). Set a dedicated
#   32-byte base64url key (openssl rand -base64 32 | tr '+/' '-_' | tr -d '=') to
#   decouple credential encryption from the auth secret; existing credentials are
#   re-sealed under it on next use. Rotating BETTER_AUTH_SECRET without a dedicated
#   key, or replacing the dedicated key under the same id, asks owners to reconnect.
KNOWLEDGEBASE_MCP_URL=
KNOWLEDGEBASE_EGRESS_ORIGINS=
ACCOUNT_CONNECTIONS_ENCRYPTION_KEY=
ACCOUNT_CONNECTIONS_ENCRYPTION_KEY_ID=k1

# Assistant chat engine (Cloud only, coo:1108). CHAT_GEMINI_API_KEY falls back to
# GEMINI_API_KEY; CHAT_GEMINI_MODEL defaults to gemini-3.8-flash. Without a key the
# engine reports not_configured. CHAT_MAX_GATHERED_BYTES_PER_RUN bounds recorded tool
# results per run (default 1048576).
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=
# Owner-keyed explicit cache of the static prompt/declarations for small requests
# (coo:1127.0904). On by default with a key; set to off to disable.
CHAT_GEMINI_STATIC_CACHE=
CHAT_MAX_GATHERED_BYTES_PER_RUN=
# Per-run and per-owner allowances. Whole numbers in the stated range; anything else
# keeps the default. A run keeps the limits in force when it was submitted.
#   CHAT_MAX_TOOL_CALLS_PER_RUN         tool calls per run (default 60, 1-500)
#   CHAT_MAX_ACTIVE_MS_PER_RUN          active processing per run, excluding time waiting
#                                       for an answer (default 600000, 120000-3600000)
#   CHAT_MAX_CONCURRENT_RUNS_PER_OWNER  unfinished runs per person (default 3, 1-50)
#   CHAT_MAX_TARGET_READS_PER_RUN       concurrent repository reads per run (default 4, 1-4)
#   CHAT_ATTEMPT_LEASE_MS               worker lease; a crashed worker's run is reclaimed
#                                       after it lapses (default 30000, 5000-600000)
#   CHAT_EVENT_RETENTION_MS / CHAT_EVENT_RETENTION_COUNT  replay retention per thread
#                                       (defaults 604800000 and 5000)
CHAT_MAX_TOOL_CALLS_PER_RUN=
CHAT_MAX_ACTIVE_MS_PER_RUN=
CHAT_MAX_CONCURRENT_RUNS_PER_OWNER=
CHAT_MAX_TARGET_READS_PER_RUN=
CHAT_ATTEMPT_LEASE_MS=
CHAT_EVENT_RETENTION_MS=
CHAT_EVENT_RETENTION_COUNT=
# Conversation notifications: milliseconds a question/finished candidate waits for a
# foreground acknowledgement before it is pushed (default 5000), and the foreground
# presence lifetime clients renew (default 30000).
CHAT_NOTIFICATION_GRACE_MS=
CHAT_PRESENCE_TTL_MS=
