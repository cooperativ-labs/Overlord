{
  "overlord": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hooks/overlord-pre-invocation.sh",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/overlord-post-tool-use.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/overlord-stop.sh",
        "timeout": 30
      }
    ]
  }
}
