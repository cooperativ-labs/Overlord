        "worktreePath": "/tmp/ovld-worktrees/coo/overlord/automate-worktree-branching-16-k7xm",
        "baseBranch": "main",
        "cycle": 1
      }
    },
    {
      "name": "cycles an isolated branch that has already merged",
      "input": {
        "mission": { "title": "Automate worktree branching", "sequence": 16 },
        "project": { "slug": "coo" },
        "resourceKey": "overlord",
        "base": "main",
        "worktreeRoot": "/tmp/ovld-worktrees",
        "recordedBranch": "automate-worktree-branching-16",
        "refs": {
          "local": ["main", "automate-worktree-branching-16", "automate-worktree-branching-16-k7xm"],
          "remote": [],
          "merged": ["automate-worktree-branching-16-k7xm"],
          "checkedOut": ["automate-worktree-branching-16"]
        },
        "isolation": { "objectiveKey": "k7xm" }
      },
      "expected": {
