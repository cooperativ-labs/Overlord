{
  "_comment": "Golden conformance vectors for Overlord's deterministic per-mission branch/worktree planning algorithm. Both the Runner Layer (cli/src/branch-planning.ts) and the service layer (backend/branch-planning.ts) keep their own copy of the algorithm; cli/test/branch-planning.test.ts and backend/branch-planning.test.ts both assert against these vectors so the two copies cannot drift. worktreePath values use POSIX separators (path.join on the supported macOS/Linux platforms). Contract version 1 makes resourceKey part of every worktree path: <worktreeRoot>/<projectSlug>/<resourceKey>/<branchLeaf>. Contract version 89 adds the optional `isolation` input: when a sibling objective of the same mission is already running on the same project resource (opt-in parallel objectives), the planner cuts a per-objective branch `<mission branch>-<objectiveKey>` off the branch it would otherwise have shared, so each concurrent objective gets its own worktree. An explicit overrideBranch opts out. Any change to the algorithm MUST regenerate this fixture and bump the contract version (see CONTRACT.md 'Shared Deterministic Algorithms').",
  "worktreeRoot": "/tmp/ovld-worktrees",
  "slugifyBranchTitle": [
    {
      "name": "strips unicode and trailing punctuation",
      "title": "Crème brûlée: ship it 🚀",
      "fallback": "mission-9",
      "expected": "creme-brulee-ship-it"
    },
    {
      "name": "falls back when nothing slugifiable remains",
      "title": "!!!",
      "fallback": "mission-9",
      "expected": "mission-9"
    }
  ],
  "canonicalMissionBranch": [
    {
      "name": "truncates long titles at a useful boundary",
      "mission": {
        "title": "This is a very long mission title that should truncate at a useful boundary",
        "sequence": 42
      },
      "expected": "this-is-a-very-long-mission-title-that-should-42"
    },
    {
      "name": "renders canonical branch from title + sequence",
      "mission": { "title": "Automate worktree branching", "sequence": 16 },
      "expected": "automate-worktree-branching-16"
    }
  ],
  "previewMissionBranch": [
    {
      "name": "predicts canonical branch and worktree path",
      "input": {
        "mission": { "title": "Automate worktree branching", "sequence": 16 },
        "project": { "slug": "coo" },
        "resourceKey": "overlord",
        "base": "main",
        "worktreeRoot": "/tmp/ovld-worktrees"
      },
      "expected": {
        "action": "create",
        "branch": "automate-worktree-branching-16",
        "worktreePath": "/tmp/ovld-worktrees/coo/overlord/automate-worktree-branching-16",
        "baseBranch": "main",
        "cycle": 1,
        "from": "main"
      }
    }
  ],
  "planMissionBranch": [
    {
      "name": "creates canonical branch when none exists yet",
      "input": {
        "mission": { "title": "Automate worktree branching", "sequence": 16 },
        "project": { "slug": "coo" },
        "resourceKey": "overlord",
        "base": "main",
        "worktreeRoot": "/tmp/ovld-worktrees",
        "recordedBranch": null,
        "refs": { "local": ["main"], "remote": [], "merged": [] }
      },
      "expected": {
        "action": "create",
        "branch": "automate-worktree-branching-16",
        "worktreePath": "/tmp/ovld-worktrees/coo/overlord/automate-worktree-branching-16",
        "baseBranch": "main",
        "cycle": 1,
        "from": "main"
      }
    },
    {
      "name": "reuses recorded unmerged branch",
      "input": {
        "mission": { "title": "Automate worktree branching", "sequence": 16 },
        "project": { "slug": "coo" },
        "resourceKey": "overlord",
        "base": "main",
        "worktreeRoot": "/tmp/ovld-worktrees",
        "recordedBranch": "automate-worktree-branching-16",
        "refs": {
          "local": ["main", "automate-worktree-branching-16"],
          "remote": [],
          "merged": []
        }
      },
      "expected": {
        "action": "reuse",
        "branch": "automate-worktree-branching-16",
        "worktreePath": "/tmp/ovld-worktrees/coo/overlord/automate-worktree-branching-16",
        "baseBranch": "main",
        "cycle": 1
      }
    },
    {
      "name": "creates next numeric cycle when recorded branch is merged",
      "input": {
        "mission": { "title": "Automate worktree branching", "sequence": 16 },
        "project": { "slug": "coo" },
        "resourceKey": "mobile",
        "base": "main",
        "worktreeRoot": "/tmp/ovld-worktrees",
        "recordedBranch": "automate-worktree-branching-16",
        "refs": {
          "local": ["main", "automate-worktree-branching-16", "automate-worktree-branching-16-2"],
          "remote": ["origin/automate-worktree-branching-16-3"],
