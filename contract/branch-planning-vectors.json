        "base": "main",
        "worktreeRoot": "/tmp/ovld-worktrees",
        "recordedBranch": "automate-worktree-branching-16",
        "refs": { "local": ["main", "automate-worktree-branching-16"], "remote": [], "merged": [], "checkedOut": ["automate-worktree-branching-16"] },
