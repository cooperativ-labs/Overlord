# In-repo development instance. Copy to `.env.local`.
#
# This file isolates source development from the global/production instance:
#   - Production / Desktop: `~/.ovld` data, API on :4310 (see `.env.prod`)
#   - In-repo dev:          repo-local data, API on :4320 (this file)
#
# Source workflows (`yarn dev`, `yarn db:*`, `yarn ovld:dev`) read `.env.local`
# only. Packaged production reads `.env.prod` only. Both can run at the same time.

GEMINI_API_KEY=

# Resend API key for sending Better Auth verification emails (sender domain:
# notifications.cooperativ.io). Leave unset to keep email verification
# disabled, e.g. for offline/local dev.
RESEND_API_KEY=

# Optional APNs credentials, shared by Live Activity updates and standard push
# notifications. Leave unset for local development; registered tokens stay
# private and no APNs requests are attempted. Use the sandbox host for
# debug/TestFlight development certificates.
OVERLORD_APNS_TEAM_ID=
OVERLORD_APNS_KEY_ID=
OVERLORD_APNS_PRIVATE_KEY=
OVERLORD_IOS_BUNDLE_ID=
OVERLORD_APNS_ENV=sandbox

APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
APPLE_ID=

# GitHub OAuth App for "Continue with GitHub" login. Set both to enable the
# GitHub button locally; unset keeps email/password as the only path. Register
# the callback URL http://127.0.0.1:4320/api/auth/callback/github on the app
# (dev API port above); repository authorization uses its /repository subpath.
# See the mission note for full dashboard setup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repository authorization reuses the login OAuth App credentials above, but
# stores its broader-scope token separately. The encryption key must decode
# from base64/base64url to exactly 32 bytes.
GITHUB_USER_TOKEN_ENCRYPTION_KEY=
# Optional dedicated key for Everhour personal API keys. When unset, Everhour
# reuses GITHUB_USER_TOKEN_ENCRYPTION_KEY. Must decode to exactly 32 bytes.
EVERHOUR_API_KEY_ENCRYPTION_KEY=
# Account connections (contracts v152, v156; Knowledgebase is Cloud only). No
# Knowledgebase setup is needed: users open Settings > Connected accounts and click
# Connect. All of the following are optional overrides.
# - KNOWLEDGEBASE_MCP_URL: unset means the standard server
#   (https://knowledge.chaselubitz.com/mcp). Set an HTTPS URL to use another server,
#   or `off` to turn Knowledgebase off. The backend reaches only this origin plus the
#   comma-separated KNOWLEDGEBASE_EGRESS_ORIGINS (an authorization server elsewhere).
#   The OAuth client id is this backend's public /oauth/clients/knowledgebase.json.
# - ACCOUNT_CONNECTIONS_ENCRYPTION_KEY: unset means credentials are sealed with a key
#   derived from BETTER_AUTH_SECRET (so keep that secret stable). Set a dedicated
#   32-byte base64url key (openssl rand -base64 32 | tr '+/' '-_' | tr -d '=') to
#   decouple credential encryption from the auth secret; existing credentials are
#   re-sealed under it on next use. Rotating BETTER_AUTH_SECRET without a dedicated
#   key, or replacing the dedicated key under the same id, asks owners to reconnect.
KNOWLEDGEBASE_MCP_URL=
KNOWLEDGEBASE_EGRESS_ORIGINS=
ACCOUNT_CONNECTIONS_ENCRYPTION_KEY=
ACCOUNT_CONNECTIONS_ENCRYPTION_KEY_ID=k1

# Assistant chat engine (Cloud only, coo:1108). CHAT_GEMINI_API_KEY falls back to
# GEMINI_API_KEY; CHAT_GEMINI_MODEL defaults to gemini-3.8-flash. Without a key the
# engine reports not_configured. CHAT_MAX_GATHERED_BYTES_PER_RUN bounds recorded tool
# results per run (default 1048576).
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=
CHAT_MAX_GATHERED_BYTES_PER_RUN=
# Per-run and per-owner allowances. Whole numbers in the stated range; anything else
# keeps the default. A run keeps the limits in force when it was submitted.
#   CHAT_MAX_TOOL_CALLS_PER_RUN         tool calls per run (default 60, 1-500)
#   CHAT_MAX_ACTIVE_MS_PER_RUN          active processing per run, excluding time waiting
#                                       for an answer (default 600000, 120000-3600000)
#   CHAT_MAX_CONCURRENT_RUNS_PER_OWNER  unfinished runs per person (default 3, 1-50)
#   CHAT_MAX_TARGET_READS_PER_RUN       concurrent repository reads per run (default 4, 1-4)
#   CHAT_ATTEMPT_LEASE_MS               worker lease; a crashed worker's run is reclaimed
#                                       after it lapses (default 30000, 5000-600000)
#   CHAT_EVENT_RETENTION_MS / CHAT_EVENT_RETENTION_COUNT  replay retention per thread
#                                       (defaults 604800000 and 5000)
CHAT_MAX_TOOL_CALLS_PER_RUN=
CHAT_MAX_ACTIVE_MS_PER_RUN=
CHAT_MAX_CONCURRENT_RUNS_PER_OWNER=
CHAT_MAX_TARGET_READS_PER_RUN=
CHAT_ATTEMPT_LEASE_MS=
CHAT_EVENT_RETENTION_MS=
CHAT_EVENT_RETENTION_COUNT=
# Conversation notifications: milliseconds a question/finished candidate waits for a
# foreground acknowledgement before it is pushed (default 5000), and the foreground
# presence lifetime clients renew (default 30000).
CHAT_NOTIFICATION_GRACE_MS=
CHAT_PRESENCE_TTL_MS=
# GitHub App integration (separate from Login with GitHub). The private key
# may be supplied with literal \n escapes when the deployment UI requires one line.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Repo-local data dir (SQLite, auth.json, connector state, and local objective ledgers).
# Git-ignored under database/.local/.
OVLD_HOME=database/.local/dev-home

# Dev API port — must differ from production :4310 in overlord.toml.
OVERLORD_WEB_HOST=127.0.0.1
OVERLORD_WEB_PORT=4320

# Vite SPA dev-server port.
OVERLORD_WEB_DEV_PORT=5173

# Dev/test backend target. Development resolves the backend from this var directly
# (never the production OVERLORD_BACKEND_URL), keeping the dev and prod channels
# isolated — important when the same machine also runs production from .env.prod.
OVERLORD_BACKEND_URL_DEV=http://127.0.0.1:4320

# Optional: keep SQL Studio on a separate dev port too.
OVERLORD_SQL_STUDIO_HOST=127.0.0.1
OVERLORD_SQL_STUDIO_PORT=4321
OVERLORD_SQL_STUDIO_BINARY=sql-studio
